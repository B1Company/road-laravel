includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    # Analyze the shipping source only. Pest test closures rebind `$this`
    # to the TestCase at runtime in a way static analysis can't follow
    # (every `$this->getJson()` / `expect()->not` reads as an undefined
    # member), so scanning tests/ at level 8 produces only framework-idiom
    # false positives. The product surface is what the gate protects.
    paths:
        - src
    tmpDir: .phpstan-cache
    treatPhpDocTypesAsCertain: false
    # Analyse against the whole supported PHP range, not just the CI runner's
    # version — catches 8.2-incompatible code even when CI runs on 8.3 (the
    # advisory currently pins the test matrix to 8.3).
    phpVersion:
        min: 80200
        max: 80400
    # PHPStan 2 reports missing iterable value types by default; we annotate the
    # value shapes we care about (DTO payloads, wire bodies) and don't require a
    # generic type on every framework `array` param.
    ignoreErrors:
        - identifier: missingType.iterableValue
        # ActsAsRoadUser is a public test helper for integrators; it reads as
        # "unused" only because we analyse src/ (not tests/, which consume it).
        -
            identifier: trait.unused
            path: src/Testing/ActsAsRoadUser.php
