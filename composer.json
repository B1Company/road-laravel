{
    "name": "b1-road/laravel",
    "description": "Official Road SDK for Laravel — BFF auth, proxy, and client for the Road IAM platform.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://portal.road.b1.app",
    "authors": [
        {
            "name": "B1 Produtos Digitais Ltda",
            "homepage": "https://portal.road.b1.app",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/B1Company/road/issues",
        "source": "https://github.com/B1Company/road/tree/main/apps/sdks/road-laravel",
        "docs": "https://portal.road.b1.app"
    },
    "keywords": ["road", "laravel", "iam", "rbac", "auth", "oidc", "bff", "b1"],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/session": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0",
        "spatie/laravel-data": "^4.0",
        "web-token/jwt-framework": "^3.3",
        "guzzlehttp/guzzle": "^7.8",
        "league/uri": "^7.0",
        "symfony/uid": "^7.0"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0",
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.17",
        "nette/php-generator": "^4.1",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^1.11|^2.0"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Auto-mounts ShareRoadContext and powers the zero-JWT @b1-road/react widget integration (^2.0)."
    },
    "autoload": {
        "psr-4": {
            "B1Road\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "B1Road\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "B1Road\\Laravel\\RoadServiceProvider"
            ],
            "aliases": {
                "Road": "B1Road\\Laravel\\Facades\\Road"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=85",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
